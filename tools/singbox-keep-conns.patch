+func interfaceStillUsable(previous *control.Interface) bool {
+	iface, err := net.InterfaceByIndex(previous.Index)
+	if err != nil || iface.Flags&net.FlagUp == 0 {
+		return false
+	}
+	addrs, err := iface.Addrs()
+	if err != nil {
+		return false
+	}
+	for _, addr := range addrs {
+		ipNet, isIPNet := addr.(*net.IPNet)
+		if !isIPNet {
+			continue
+		}
+		ip, ok := netip.AddrFromSlice(ipNet.IP)
+		if !ok || ip.Unmap().IsLinkLocalUnicast() {
+			continue
+		}
+		for _, prefix := range previous.Addresses {
+			if prefix.Addr() == ip.Unmap() {
+				return true
+			}
+		}
+	}
+	return false
+}
